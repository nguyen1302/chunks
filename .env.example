# MongoDB Atlas (server-only — never expose to the browser)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=chunks

# Web Push reminders — generate with `node scripts/gen-vapid.mjs`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects the reminder cron endpoint (any random string)
CRON_SECRET=

# Notion (only needed for the one-time migration script; app no longer uses it)
NOTION_TOKEN=secret_xxx
NOTION_DB_EXPRESSIONS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_REVIEW_EXAMPLES=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
